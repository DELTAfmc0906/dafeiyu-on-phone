<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗（在其他应用上层显示）。Android 6+ 需用户在系统设置里手动授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网络：天气查询 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 语音输入（按住说话）—— v1.2.3 新增，运行时申请 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Android 11+ 的包可见性：不声明的话 SpeechRecognizer.isRecognitionAvailable()
      会一直返回 false，语音功能直接不可用。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".DafeiyuApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DafeiyuPet">

        <!-- 设置 / 控制面板 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AI 对话界面（v1.2.2 起改为 Activity，见 ChatActivity 注释） -->
        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DafeiyuPet.Chat" />

        <!--
          AI 与账号设置（v1.3.1）。
          从对话窗口的 ⚙ 齿轮或主设置页的入口卡片进入。
          独立成页是因为 v1.3 把它埋进设置页深处后，用户反馈"API 设置被吃掉了"。
        -->
        <activity
            android:name=".ui.AiSettingsActivity"
            android:exported="false"
            android:label="AI 与账号" />

        <!-- 悬浮窗前台服务 -->
        <service
            android:name=".ui.PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="桌面宠物悬浮窗常驻显示" />
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".ui.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
